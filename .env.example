# ============================================
# Price Monitor - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Timezone for scheduling (default: Europe/Bucharest)
TZ=Europe/Bucharest

# Database URL (SQLite by default, supports PostgreSQL too)
DATABASE_URL=sqlite:///data/price_monitor.db

# Telegram Bot Configuration (optional - for price drop notifications)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID(s) - comma-separated for multiple chats
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Price check schedule (24h format, comma-separated)
# Default: 9:00 AM and 2:00 PM
PRICE_CHECK_TIMES=09:00,14:00

# Server Configuration
PORT=4300
HOST=0.0.0.0

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO