# ============================================
# Price Monitor - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Timezone for scheduling (default: Europe/Bucharest)
TZ=Europe/Bucharest

# Database URL (SQLite by default, supports PostgreSQL too)
DATABASE_URL=sqlite:///data/price_monitor.db

# Telegram Bot Configuration (optional - for price drop notifications)
# Get your bot token from @BotFather on Telegram.
# Each user configures their own Chat ID via the web settings page.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Price check schedule (24h format, comma-separated)
# Default: 9:00 AM and 2:00 PM
PRICE_CHECK_TIMES=09:00,14:00

# Alternate-link discovery schedule (24h format, comma-separated) - optional
# When set, at these times the app searches the web for the same product
# (matched by EAN/GTIN/UPC/ASIN, model number, exact title phrase or title
# keywords; only on other sites with the same country domain suffix, e.g. .ro)
# and stores the cheapest verified links.
# Leave empty to disable the feature.
ALTERNATE_LINK_TIMES=

# Maximum number of alternate links kept per product (default: 3)
ALTERNATE_LINKS_MAX=3

# Minimum price drop (in the product's currency) that triggers a "price dropped"
# Telegram notification - smaller drops are ignored as meaningless savings. Default: 10
PRICE_DROP_MIN=10

# Exchange-rate cache: how often (hours) to re-fetch the EUR-anchored rate table
# from the public FX APIs (frankfurter.dev, fallback open.er-api.com). Default: 12.
FX_RATE_TTL_HOURS=12

# How old (hours) a cached rate table may be before it is discarded entirely and
# cross-currency comparison is disabled. Default: 168 (one week).
FX_RATE_MAX_STALE_HOURS=168

# Server Configuration
# In-container port (Docker maps 13020 → 3000)
PORT=3000
HOST=0.0.0.0

# Enable/Disable new user sign-up (default: true)
# Set to "false" or "0" to prevent new registrations while allowing existing users to log in
ENABLE_SIGNUP=true

# Secret used to sign auth tokens (HMAC-SHA256).
# Leave empty to let the app auto-generate one and persist it next to the
# database file (survives restarts on the Docker volume). Set it explicitly
# if you run multiple replicas or move the data volume to another host.
PM_TOKEN_SECRET=

# Comma-separated list of origins allowed to call the API cross-origin (CORS).
# Leave empty to disable CORS entirely (default) - the SPA is served same-origin.
PM_CORS_ORIGINS=

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Database Backup & Restore (Dropbox)
# ============================================

# Enable/Disable database backups (default: true)
BACKUP_ENABLED=true

# Dropbox app credentials - create an app at https://www.dropbox.com/developers/apps
# (App Folder or Full Dropbox, file contents read/write scopes, OAuth 2.0 token refresh enabled)
# and paste the refresh token, App Key and App Secret below.
BACKUP_DROPBOX_REFRESH_TOKEN=
BACKUP_DROPBOX_APP_KEY=
BACKUP_DROPBOX_APP_SECRET=

# Dropbox folder where backups are stored (default: /Backup)
BACKUP_DROPBOX_FOLDER=/Backup

# Delete backups older than this many days (default: 30)
BACKUP_RETENTION_DAYS=30

# Cron expression for the scheduled backup (default: daily at 02:00, server timezone)
# Set empty to disable the scheduled backup (manual "Backup Now" still works)
BACKUP_SCHEDULE=0 2 * * *

# One-shot restore on startup: set to "true" ONCE to replace the database with the
# newest Dropbox backup (a safety copy of the current DB is kept in backups/ first),
# then set it back to "false". (default: false)
RESTORE_LATEST_BACKUP=false
